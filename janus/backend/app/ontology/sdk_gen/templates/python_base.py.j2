from __future__ import annotations

import json
import os
from dataclasses import dataclass
from typing import Any, ClassVar

try:
    import httpx
    _HAS_HTTPX = True
except ImportError:
    _HAS_HTTPX = False
    httpx = None  # type: ignore


JUNO_BASE_URL = os.environ.get("JUNO_API_URL", "http://localhost:9050")


# =============================================================================
# Tipos primitivos compartilhados
# =============================================================================

@dataclass(frozen=True)
class Money:
    amount: float
    currency: str = "BRL"

    def __float__(self) -> float:
        return float(self.amount)

    def __str__(self) -> str:
        return f"{self.currency} {self.amount:,.2f}"


@dataclass
class ActionResult:
    success: bool
    before: dict[str, Any]
    after: dict[str, Any]
    diff: dict[str, dict[str, Any]]
    audit_id: int | None
    warnings: list[str]
    dry_run: bool


# =============================================================================
# Exceptions
# =============================================================================

class OntologyClientError(Exception):
    """Erro generico do cliente."""


class ObjectNotFound(OntologyClientError):
    """404."""


class PermissionDenied(OntologyClientError):
    """403."""


class ValidationFailed(OntologyClientError):
    """400 com lista de erros."""
    def __init__(self, errors: list[dict]):
        self.errors = errors
        super().__init__(f"validation failed ({len(errors)} erros)")


# =============================================================================
# HTTPClient
# =============================================================================

class HTTPClient:
    """Cliente HTTP com auth Bearer. httpx se disponivel; fallback urllib."""

    def __init__(self, base_url: str | None = None, token: str | None = None, timeout: float = 30.0):
        self.base_url = (base_url or JUNO_BASE_URL).rstrip("/")
        self.token = token or os.environ.get("JUNO_API_TOKEN", "")
        self.timeout = timeout

    def _headers(self) -> dict[str, str]:
        h = {"Content-Type": "application/json", "Accept": "application/json"}
        if self.token:
            h["Authorization"] = f"Bearer {self.token}"
        return h

    def _url(self, path: str) -> str:
        return f"{self.base_url}{path}"

    def get(self, path: str, **params) -> Any:
        return self._request("GET", path, params=params)

    def post(self, path: str, body: dict | None = None, **params) -> Any:
        return self._request("POST", path, body=body, params=params)

    def _request(self, method: str, path: str, *, body: dict | None = None, params: dict | None = None) -> Any:
        if _HAS_HTTPX:
            r = httpx.request(
                method, self._url(path), headers=self._headers(),
                json=body, params=params or None, timeout=self.timeout,
            )
            self._raise_for_status(r.status_code, r.text)
            return r.json() if r.text else None
        else:
            from urllib import parse, request, error
            url = self._url(path)
            if params:
                url += "?" + parse.urlencode({k: v for k, v in params.items() if v is not None})
            data = json.dumps(body).encode("utf-8") if body is not None else None
            req = request.Request(url, data=data, method=method, headers=self._headers())
            try:
                with request.urlopen(req, timeout=self.timeout) as resp:
                    text = resp.read().decode("utf-8")
                    return json.loads(text) if text else None
            except error.HTTPError as e:
                text = e.read().decode("utf-8", errors="replace")
                self._raise_for_status(e.code, text)

    @staticmethod
    def _raise_for_status(status: int, text: str) -> None:
        if 200 <= status < 300:
            return
        body: Any = text
        try:
            body = json.loads(text)
        except Exception:
            pass
        if status == 404:
            raise ObjectNotFound(body)
        if status == 403:
            raise PermissionDenied(body)
        if status == 400 and isinstance(body, dict) and "validation_errors" in body.get("detail", {}):
            raise ValidationFailed(body["detail"]["validation_errors"])
        raise OntologyClientError(f"HTTP {status}: {body}")


# Cliente default (lazy)
_default_client: HTTPClient | None = None


def get_client() -> HTTPClient:
    global _default_client
    if _default_client is None:
        _default_client = HTTPClient()
    return _default_client


def set_client(client: HTTPClient) -> None:
    global _default_client
    _default_client = client


# =============================================================================
# Base ObjectClient
# =============================================================================

class ObjectClient:
    """Base de todas as classes geradas. Subclasses fixam OBJECT_TYPE."""
    OBJECT_TYPE: ClassVar[str] = ""

    def __init__(self, **data: Any):
        for k, v in data.items():
            setattr(self, k, v)
        self._raw = data

    @classmethod
    def get(cls, object_id: Any, *, client: HTTPClient | None = None) -> "ObjectClient":
        c = client or get_client()
        data = c.get(f"/api/v1/ontology/{cls.OBJECT_TYPE}/{object_id}")
        return cls(**data)

    @classmethod
    def list(cls, *, limit: int = 50, offset: int = 0, order_by: str | None = None,
             client: HTTPClient | None = None) -> dict[str, Any]:
        c = client or get_client()
        res = c.get(f"/api/v1/ontology/{cls.OBJECT_TYPE}",
                    limit=limit, offset=offset, order_by=order_by)
        res["items"] = [cls(**d) for d in res["items"]]
        return res

    @classmethod
    def search(cls, q: str, *, limit: int = 20,
               client: HTTPClient | None = None) -> list["ObjectClient"]:
        c = client or get_client()
        items = c.get(f"/api/v1/ontology/{cls.OBJECT_TYPE}/search", q=q, limit=limit)
        return [cls(**d) for d in items]

    def _execute_action(self, action_name: str, inputs: dict[str, Any], *,
                        dry_run: bool = False, actor_type: str = "user",
                        confirmed_by: int | None = None,
                        client: HTTPClient | None = None) -> ActionResult:
        c = client or get_client()
        body = {"inputs": inputs, "actor_type": actor_type, "confirmed_by": confirmed_by}
        data = c.post(
            f"/api/v1/ontology/{self.OBJECT_TYPE}/{self.id}/actions/{action_name}",
            body=body, dry_run=str(dry_run).lower(),
        )
        return ActionResult(**data)
