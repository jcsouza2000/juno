# ====================================================================
# JUNO Backend — Variáveis de ambiente
# ====================================================================
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commit o .env no git.

# === Ambiente ===
# development | staging | production
JUNO_ENV=development

# === Segurança ===
# Gere uma chave forte:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Obrigatória em produção. Em dev, se vazia, é gerada aleatoriamente
# a cada start (invalida JWTs antigos).
SECRET_KEY=

# Chave Fernet para criptografar senhas de ERP, API keys, etc. (32-bytes b64).
# Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Obrigatória em produção. Em dev, se vazia, é derivada de SECRET_KEY.
ENCRYPTION_KEY=

# === Banco de dados ===
# Em prod, obrigatória. Em dev, default = sqlite:///./juno_dev.db
DATABASE_URL=postgresql://user:senha_forte@localhost:5432/juno_db

# === CORS ===
# Lista separada por vírgula. Use HTTPS em prod.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:9050

# === OpenAI ===
OPENAI_API_KEY=

# === Rate limiting ===
# Formato: "Nrequests/period" (ex: "5/minute", "100/hour")
LOGIN_RATE_LIMIT=5/minute

# === Logging ===
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
