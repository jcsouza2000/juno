# JUNO / Janus AI — Environment Configuration (template raiz)
# Copie para .env (na raiz do janus/) e ajuste os valores.
# Este arquivo cobre variáveis usadas por docker-compose.yml,
# observabilidade e integrações de terceiros.

# === Banco de dados (Postgres no Docker Compose) ===
DB_USER=juno
DB_PASSWORD=TROCAR_PARA_SENHA_FORTE
DB_NAME=juno_db
DB_HOST=postgres
DB_PORT=5432

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Segurança ===
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=GERAR_UMA_CHAVE_DE_PELO_MENOS_32_CARACTERES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# === Ambiente ===
JUNO_ENV=development
LOG_LEVEL=INFO

# === Grafana ===
GRAFANA_USER=admin
GRAFANA_PASSWORD=TROCAR_PARA_SENHA_FORTE
GRAFANA_ROOT_URL=http://localhost:3000

# === Backups / S3 ===
BACKUP_RETENTION_DAYS=7
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# === Observabilidade (fase 10) ===
JAEGER_HOST=jaeger
JAEGER_PORT=4317
OTEL_SERVICE_NAME=juno-api
SENTRY_DSN=
RELEASE=1.0.0

# === Notificações ===
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=
PAGERDUTY_SRE_KEY=
PAGERDUTY_CRITICAL_KEY=

# === Integrações de pagamento (fase 11) ===
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
PAGARME_API_KEY=
PAGARME_ENCRYPTION_KEY=

# === CRM ===
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
HUBSPOT_API_KEY=

# === ERPs ===
SAP_BASE_URL=
TOTVS_BASE_URL=
ODOO_URL=

# === Messaging ===
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASS=TROCAR_PARA_SENHA_FORTE
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# === AI/ML (fase 12) ===
CHROMADB_PERSIST_DIR=./data/chromadb
EMBEDDING_MODEL=all-MiniLM-L6-v2
BASE_LLM_MODEL=microsoft/DialoGPT-medium
LORA_R=16
LORA_ALPHA=32
MODELS_DIR=./models/registry
AB_TEST_TTL_DAYS=30
