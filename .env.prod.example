# JUNO Production Environment Example
# Copie para .env.prod e preencha valores reais.
# NUNCA commitar .env.prod.

# SEGURANCA (C2): producao explicita + bypass de auth desligado.
JUNO_ENV=production
JUNO_DEV_AUTH_BYPASS=false
POSTGRES_PASSWORD=troque_esta_senha
DATABASE_URL=postgresql://juno:troque_esta_senha@postgres:5432/juno
REDIS_URL=redis://redis:6379/0
SECRET_KEY=gere_com_python_secrets_token_urlsafe_64
ENCRYPTION_KEY=gere_com_cryptography_fernet
ALLOWED_ORIGINS=https://seudominio.com.br
LOGIN_RATE_LIMIT=5/minute
LOG_FORMAT=json
RUN_MIGRATIONS=true
NEXT_PUBLIC_API_URL=https://api.seudominio.com.br
NEXTAUTH_SECRET=gere_com_openssl_rand_base64_32
AUTH_SECRET=gere_com_openssl_rand_base64_32
